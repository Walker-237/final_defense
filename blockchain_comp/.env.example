# Même base que le backend Spring (docker-compose) — le script anchor.js lit
# audit_chain_state et écrit audit_chain_anchors directement, sans passer par
# l'API. Voir backend/.env pour les valeurs réelles de ce projet.
DATABASE_URL=postgresql://afb_app:change_me_db@localhost:5433/afb_titres

# Uniquement nécessaires pour `npm run deploy:sepolia` / `npm run anchor:sepolia`
# (réseau de test PUBLIC). Laissez vide pour rester en local
# (`npm run node` + `npm run deploy:local` + `npm run anchor:local`) — aucun
# compte ni clé API externe requis dans ce cas.
#
# SEPOLIA_RPC_URL : point de terminaison RPC (ex. via Infura ou Alchemy,
#   inscription gratuite).
# SEPOLIA_PRIVATE_KEY : clé privée d'un compte de test financé via un faucet
#   Sepolia (ETH de test, sans valeur réelle). NE JAMAIS utiliser une clé
#   détenant des fonds réels.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
